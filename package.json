{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vp build",
        "build:ssr": "vp build && vp build --ssr",
        "dev": "vp dev",
        "check": "vp check",
        "check:fix": "vp check --fix",
        "types:check": "vue-tsc --noEmit",
        "test:vrt": "docker run --rm --platform linux/arm64 --ipc=host -v \"$PWD\":/work -v mixtend-vrt-node-modules:/work/node_modules -w /work mcr.microsoft.com/playwright:v1.63.0-noble sh -c 'npm ci --no-audit --no-fund --loglevel=error && npx vp test \"$@\"' sh",
        "test:vrt:update": "npm run test:vrt -- --update"
    },
    "dependencies": {
        "@inertiajs/vite": "^3.0.0",
        "@inertiajs/vue3": "^3.0.0",
        "@lucide/vue": "^1.51.0",
        "@tailwindcss/vite": "^4.1.11",
        "@vitejs/plugin-vue": "^6.0.0",
        "clsx": "^2.1.1",
        "concurrently": "^10.0.3",
        "dayjs": "^1.11.23",
        "laravel-vite-plugin": "^3.1",
        "tailwind-merge": "^3.2.0",
        "tailwindcss": "^4.1.1",
        "typescript": "^5.2.2",
        "vite": "^8.0.0",
        "vue": "^3.5.13"
    },
    "devDependencies": {
        "@laravel/vite-plugin-wayfinder": "^0.1.3",
        "@types/node": "^22.13.5",
        "@vitest/browser-playwright": "4.1.11",
        "playwright": "1.63.0",
        "vite-plus": "0.3.0",
        "vue-tsc": "^2.2.4"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1",
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1"
    }
}
